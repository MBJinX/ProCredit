# Bash assignments. Quote values containing spaces.
# Use a directory on a local disk. The setup command installs public data here.
APPWORLD_ROOT=/dev/shm/procredit-${UID}
APPWORLD_PYTHON=python
TASK_IDS=82e2fac_1
# actions: run one Python snippet per turn from a JSON array. model: query your endpoint.
RUN_MODE=actions
ACTIONS_FILE=examples/inspect.json
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_NAME=
MODEL_API_KEY=
APPWORLD_MAX_TURNS=12
APPWORLD_STEP_TERMINAL=keep
APPWORLD_SHAPING_COEF=0.5
UI_PORT=8080

# Optional single-node GPU training, in a separate Python environment.
TRAIN_PYTHON=python
TRAIN_MODEL=
TRAIN_GPUS=1
TRAIN_STEPS=5
ROLLOUTS_PER_TASK=2
